# ==============================================
# Activ Academy — Frontend Environment Variables
# ==============================================

# Backend API Endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000
INTERNAL_API_URL=http://app:3000

# Base URL for Webhooks & Callbacks
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stripe Payment Gateway Configuration (Optional)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Paymob Payment Gateway Configuration (Optional)
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_INTEGRATION_ID=your_paymob_integration_id_here
PAYMOB_IFRAME_ID=your_paymob_iframe_id_here
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here

# NextAuth Configuration (Optional)
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000
