# ==============================================
# Activ Academy — Backend Environment Variables
# ==============================================

# Server Port
PORT=3000

# MongoDB Database Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/coaching_db

# JWT Secret Key for Authentication Tokens
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key for AI Analysis Service
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Optional / Alternate AI provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SMTP / Email Service Configuration (Yahoo Mail SMTP for contact & complaints)
MAIL_USER=your_yahoo_email@yahoo.com
MAIL_PASS=your_yahoo_app_generated_password
